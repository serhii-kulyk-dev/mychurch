# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# статичний експорт (output: export, distDir)
/.static/

# production
/build

# випадково збережені шматки збірки в корені — не в репозиторій
/404.html
/__next.*.txt

# analytics (свої події — не в репозиторій)
/.data

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# токен бота для приймача заявок — живе на хостингу, не в репозиторії
lead-secret.php

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
/.claude/worktrees

# python bytecode
__pycache__/
*.pyc

# демо-записи: 8 файлів по ~10 МБ їдуть на хостинг зі збіркою,
# але в репозиторії їм робити нічого (оригінали — в «Готове відео»)
/public/clips/
