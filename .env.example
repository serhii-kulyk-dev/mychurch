# Сайт збирається в статику (output: "export" у next.config.ts), тож
# серверних змінних тут немає: усе, що нижче, потрапляє в браузер.

# ── Заявки ───────────────────────────────────────────────────────────────────
# Куди форма демо і бриф на /modules шлють ліда: повна адреса приймача,
# який приймає POST з JSON і сам пише в Telegram (токен бота живе там,
# а не тут — у статику його класти не можна).
# Порожньо — форма чесно показує телефон і пошту замість «дякуємо».
NEXT_PUBLIC_LEAD_ENDPOINT=

# Публічне посилання на Telegram для кнопок «Написати в Telegram».
# Порожнє — кнопки ведуть на https://t.me/mychurch_team (SITE_TELEGRAM_HANDLE у src/lib/seo.ts).
NEXT_PUBLIC_TELEGRAM_URL=

# Домен для canonical/OG у прев'ю та стейджингу
NEXT_PUBLIC_SITE_URL=

# ── Аналітика: Firebase Analytics (GA4) ──────────────────────────────────────
# Єдиний лічильник сайту. Конфіг беруть у консолі Firebase →
# Project settings → Your apps. Порожні значення = статистика не збирається.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Токен підтвердження прав у Google Search Console (тег google-site-verification).
# Порожньо — тег не додається.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
