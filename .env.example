# Куди падають ліди з форми демо і з брифу на /modules.
# Достатньо одного каналу; якщо не задано жодного — /api/lead віддає 503,
# і форма чесно показує телефон і пошту замість «дякуємо».

# Telegram: бот і чат, у який він пише
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Пошта через Resend (https://resend.com)
RESEND_API_KEY=
LEAD_EMAIL_FROM=
# Куди слати; за замовчуванням team@mychurch.com.ua
LEAD_EMAIL_TO=

# Публічне посилання на Telegram для кнопок «Написати в Telegram».
# Порожнє — кнопки ведуть на https://t.me/mychurch_team (SITE_TELEGRAM_HANDLE у src/lib/seo.ts).
NEXT_PUBLIC_TELEGRAM_URL=

# Домен для canonical/OG у прев'ю та стейджингу
NEXT_PUBLIC_SITE_URL=

# ── Аналітика ────────────────────────────────────────────────────────────────
# Пароль до кабінету /admin. Без нього кабінет закритий і нічого не показує.
ANALYTICS_PASSWORD=
# Ключ для підпису куки входу; якщо порожній — береться сам пароль.
ANALYTICS_SECRET=

# Де зберігати події.
# Типово — файли JSONL у <корінь>/.data/analytics (підходить для VPS і Docker).
ANALYTICS_DIR=
# На serverless (Vercel) файлова система тільки для читання — задайте Redis:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Скільки діб тримати події (типово 400).
ANALYTICS_RETENTION_DAYS=
# Часовий пояс звітів (типово Europe/Kyiv).
ANALYTICS_TZ=

# ── Firebase Analytics (GA4) ─────────────────────────────────────────────────
# Другий канал статистики: звичні звіти Google поруч із власним кабінетом.
# Конфіг беруть у консолі Firebase → Project settings → Your apps.
# Порожні значення = GA4 вимкнено, свій лічильник працює далі.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Токен підтвердження прав у Google Search Console (тег google-site-verification).
# Порожньо — тег не додається.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
